<div class="container">
  <%= if @stuck? do %>
    <div class="alert alert--warning" style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px;">
      <strong>Warning:</strong> This thread appears stuck — state <code><%= @thread.state %></code> has not changed in over <%= if @thread.state == "executing", do: "2 hours", else: "48 hours" %>.
    </div>
  <% end %>

  <h1 class="page-title">
    <%= GuildWeb.Format.anchor_label(@thread) %>
    <span class={"badge badge--#{@thread.state}"} style="margin-left: 0.75rem; font-size: 0.6em; vertical-align: middle;">
      <%= @thread.state %>
    </span>
  </h1>

  <section class="info-card">
    <dl class="info-grid">
      <dt>ID</dt>
      <dd><code><%= @thread.id %></code></dd>
      <dt>Anchor</dt>
      <dd><span class="mono"><%= @thread.anchor_type %></span> / <span class="mono"><%= @thread.anchor_id %></span></dd>
      <%= if @thread.anchor_url do %>
        <dt>URL</dt>
        <dd><a href={@thread.anchor_url} target="_blank" rel="noopener"><%= @thread.anchor_url %></a></dd>
      <% end %>
      <dt>Owner</dt>
      <dd><%= @thread.owner || raw("<span class=\"muted\">—</span>") %></dd>
      <dt>Created</dt>
      <dd class="timestamp"><%= GuildWeb.Format.time(@thread.inserted_at) %></dd>
      <dt>Updated</dt>
      <dd class="timestamp"><%= GuildWeb.Format.time(@thread.updated_at) %></dd>
      <%= if @thread.slack_thread_ts do %>
        <dt>Slack</dt>
        <dd>
          <a href={"https://slack.com/app_redirect?channel=#{@thread.slack_channel}&message=#{@thread.slack_thread_ts}"}
             target="_blank" rel="noopener">Open in Slack</a>
        </dd>
      <% end %>
    </dl>
  </section>

  <%!-- Thread action buttons — plain HTML POST forms, not LiveView events --%>
  <% terminal_states = ["done", "abandoned"] %>
  <% is_terminal = @thread.state in terminal_states %>

  <%= unless is_terminal do %>
    <div class="thread-actions" style="margin: 1rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <%= unless @thread.held do %>
        <% active_states = ["executing", "pr_open"] %>
        <%= if @thread.state in active_states do %>
          <form action={~p"/threads/#{@thread.id}/hold"} method="post">
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <button type="submit" class="btn btn--warning">Hold</button>
          </form>
        <% end %>
      <% end %>

      <%= if @thread.held do %>
        <form action={~p"/threads/#{@thread.id}/resume"} method="post">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <button type="submit" class="btn btn--primary">Resume</button>
        </form>
      <% end %>

      <form action={~p"/threads/#{@thread.id}/abandon"} method="post">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <button type="submit" class="btn btn--danger"
          onclick="return confirm('Abandon this thread? This cannot be undone.')">
          Abandon
        </button>
      </form>
    </div>
  <% end %>

  <h2 class="section-title">Timeline (<%= length(@timeline) %>)</h2>
  <%= if Enum.empty?(@timeline) do %>
    <p class="empty-state">No activity yet.</p>
  <% else %>
    <ul class="timeline-list" style="list-style: none; padding: 0; margin: 0;">
      <%= for entry <- @timeline do %>
        <li class="timeline-item" style="display: flex; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px solid #eee; align-items: flex-start;">
          <span class={"badge badge--#{entry.kind}"} style="flex-shrink: 0; min-width: 5rem; text-align: center;">
            <%= entry.kind %>
          </span>
          <span class="timeline-summary" style="flex: 1;">
            <%= entry.summary %>
            <%= if entry.kind == "decision" && !entry.meta.has_snapshot do %>
              <span class="badge badge--trimmed" style="margin-left: 0.5rem; font-size: 0.75em; opacity: 0.7;">snapshot trimmed</span>
            <% end %>
          </span>
          <span class="timestamp" style="flex-shrink: 0; white-space: nowrap;">
            <%= GuildWeb.Format.time(entry.timestamp) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
