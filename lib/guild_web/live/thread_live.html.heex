<div class="container">
  <h1 class="page-title">
    <%= GuildWeb.Format.anchor_label(@thread) %>
    <span class={"badge badge--#{@thread.state}"} style="margin-left: 0.75rem; font-size: 0.6em; vertical-align: middle;">
      <%= @thread.state %>
    </span>
  </h1>

  <section class="info-card">
    <dl class="info-grid">
      <dt>ID</dt>
      <dd><code><%= @thread.id %></code></dd>
      <dt>Anchor</dt>
      <dd><span class="mono"><%= @thread.anchor_type %></span> / <span class="mono"><%= @thread.anchor_id %></span></dd>
      <%= if @thread.anchor_url do %>
        <dt>URL</dt>
        <dd><a href={@thread.anchor_url} target="_blank" rel="noopener"><%= @thread.anchor_url %></a></dd>
      <% end %>
      <dt>Owner</dt>
      <dd><%= @thread.owner || raw("<span class=\"muted\">—</span>") %></dd>
      <dt>Created</dt>
      <dd class="timestamp"><%= GuildWeb.Format.time(@thread.inserted_at) %></dd>
      <dt>Updated</dt>
      <dd class="timestamp"><%= GuildWeb.Format.time(@thread.updated_at) %></dd>
    </dl>
  </section>

  <h2 class="section-title">Events (<%= length(@thread.events) %>)</h2>
  <%= if Enum.empty?(@thread.events) do %>
    <p class="empty-state">No events yet.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Source</th>
          <th>Type</th>
          <th>Actor</th>
        </tr>
      </thead>
      <tbody>
        <%= for event <- @thread.events do %>
          <tr>
            <td class="timestamp"><%= GuildWeb.Format.time(event.occurred_at) %></td>
            <td class="mono"><%= event.source %></td>
            <td class="mono"><%= event.event_type %></td>
            <td class="muted">
              <%= cond do
                event.actor_type && event.actor_id -> "#{event.actor_type}/#{event.actor_id}"
                event.actor_type -> event.actor_type
                event.actor_id -> event.actor_id
                true -> "—"
              end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2 class="section-title">Context Notes (<%= length(@thread.context_notes) %>)</h2>
  <%= if Enum.empty?(@thread.context_notes) do %>
    <p class="empty-state">No context notes yet.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Body</th>
          <th>When</th>
        </tr>
      </thead>
      <tbody>
        <%= for note <- @thread.context_notes do %>
          <tr>
            <td class="mono"><%= note.note_type %></td>
            <td><%= note.body %></td>
            <td class="timestamp"><%= GuildWeb.Format.time(note.inserted_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2 class="section-title">Decisions (<%= length(@thread.decisions_log) %>)</h2>
  <%= if Enum.empty?(@thread.decisions_log) do %>
    <p class="empty-state">No decisions yet.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Action</th>
          <th>Reasoning</th>
          <th>When</th>
        </tr>
      </thead>
      <tbody>
        <%= for decision <- @thread.decisions_log do %>
          <tr>
            <td class="mono"><%= decision.decision_type %></td>
            <td class="reasoning-cell">
              <%= String.slice(decision.reasoning || "", 0, 160) %><%= if String.length(decision.reasoning || "") > 160, do: "…" %>
            </td>
            <td class="timestamp"><%= GuildWeb.Format.time(decision.inserted_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2 class="section-title">Artifacts (<%= length(@thread.artifacts) %>)</h2>
  <%= if Enum.empty?(@thread.artifacts) do %>
    <p class="empty-state">No artifacts yet.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Source</th>
          <th>Link</th>
        </tr>
      </thead>
      <tbody>
        <%= for artifact <- @thread.artifacts do %>
          <tr>
            <td class="mono"><%= artifact.artifact_type %></td>
            <td class="mono muted"><%= artifact.source %></td>
            <td>
              <%= cond do
                artifact.url && artifact.url != "" -> nil
                true -> nil
              end %>
              <%= if artifact.url && artifact.url != "" do %>
                <a href={artifact.url} target="_blank" rel="noopener">
                  <%= artifact.url %>
                </a>
              <% else %>
                <%= if artifact.artifact_type == "fountain_conversation" and @fountain_base_url != "" do %>
                  <a href={"#{@fountain_base_url}/conversations/#{artifact.external_id}"} target="_blank" rel="noopener">
                    <code><%= artifact.external_id %></code>
                  </a>
                <% else %>
                  <code><%= artifact.external_id %></code>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
