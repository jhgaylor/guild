<Layouts.flash_group flash={@flash} />
<div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
  <div class="mx-auto max-w-xl">
    <h1 class="text-4xl font-bold tracking-tight">Guild</h1>
    <p class="mt-4 text-lg leading-7 text-base-content/70">
      Guild is a platform for building autonomous workers that participate in the software development lifecycle.
      This deploy hosts the operator UI for a self-hosting Guild instance.
    </p>
    <nav class="mt-8">
      <ul class="flex flex-col gap-2">
        <li>
          <a href="/threads" class="text-base font-medium hover:underline">
            Threads
          </a>
        </li>
        <li>
          <a href="/decisions" class="text-base font-medium hover:underline">
            Decisions
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>
