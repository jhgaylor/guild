<div class="container">
  <h1 class="page-title">Admin</h1>
  <p class="page-subtitle">Operator tools for managing Guild.</p>

  <div class="admin-cards">
    <a href={~p"/admin/repos"} class="admin-card">
      <h2>Repos</h2>
      <p>Manage watched repositories and their configurations.</p>
    </a>

    <a href={~p"/admin/workers"} class="admin-card">
      <h2>Workers</h2>
      <p>Inspect and manage Guild worker configuration.</p>
    </a>

    <a href={~p"/admin/integrations"} class="admin-card">
      <h2>Integrations</h2>
      <p>Check the status of GitHub, Slack, Linear, and Fountain integrations.</p>
    </a>
  </div>
</div>
