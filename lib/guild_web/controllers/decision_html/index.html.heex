<Layouts.flash_group flash={@flash} />
<div class="container">
  <h1 class="page-title">Decisions</h1>
  <p class="page-subtitle">
    <%= length(@decisions) %> recent decisions across all threads.
  </p>

  <%= if Enum.empty?(@decisions) do %>
    <p class="empty-state">No decisions logged yet.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Thread</th>
          <th>Action</th>
          <th>Reasoning</th>
          <th>When</th>
        </tr>
      </thead>
      <tbody>
        <%= for decision <- @decisions do %>
          <tr>
            <td>
              <a href={~p"/threads/#{decision.thread_id}"} class="anchor-link">
                <%= if decision.thread,
                  do: GuildWeb.Format.anchor_label(decision.thread),
                  else: GuildWeb.Format.short_id(decision.thread_id) %>
              </a>
            </td>
            <td><span class="mono"><%= decision.decision_type %></span></td>
            <td class="reasoning-cell">
              <%= String.slice(decision.reasoning || "", 0, 160) %><%= if String.length(decision.reasoning || "") > 160, do: "…" %>
            </td>
            <td class="timestamp"><%= GuildWeb.Format.time(decision.inserted_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
