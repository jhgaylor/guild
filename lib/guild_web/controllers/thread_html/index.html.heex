<Layouts.flash_group flash={@flash} />
<div class="px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Threads</h1>
  <table class="w-full border-collapse border border-gray-300">
    <thead>
      <tr class="bg-gray-100">
        <th class="border border-gray-300 px-4 py-2 text-left">Anchor Type</th>
        <th class="border border-gray-300 px-4 py-2 text-left">Anchor ID</th>
        <th class="border border-gray-300 px-4 py-2 text-left">State</th>
        <th class="border border-gray-300 px-4 py-2 text-left">Owner</th>
        <th class="border border-gray-300 px-4 py-2 text-left">Created</th>
        <th class="border border-gray-300 px-4 py-2 text-left">Updated</th>
      </tr>
    </thead>
    <tbody>
      <%= for thread <- @threads do %>
        <tr class="hover:bg-gray-50">
          <td class="border border-gray-300 px-4 py-2">
            <a href={~p"/threads/#{thread.id}"} class="text-blue-600 hover:underline">
              <%= thread.anchor_type %>
            </a>
          </td>
          <td class="border border-gray-300 px-4 py-2"><%= thread.anchor_id %></td>
          <td class="border border-gray-300 px-4 py-2"><%= thread.state %></td>
          <td class="border border-gray-300 px-4 py-2"><%= thread.owner %></td>
          <td class="border border-gray-300 px-4 py-2"><%= thread.inserted_at %></td>
          <td class="border border-gray-300 px-4 py-2"><%= thread.updated_at %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
