<Layouts.flash_group flash={@flash} />
<GuildWeb.ReadinessBanner.banner gaps={@gaps} />
<div class="container">
  <h1 class="page-title">Threads</h1>

  <%= unless Enum.empty?(@recent) do %>
    <section class="recent-activity" style="margin-bottom: 1.5rem;">
      <h2 class="section-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Recent Activity</h2>
      <ul style="list-style: none; padding: 0; margin: 0;">
        <%= for thread <- @recent do %>
          <%
            ref = thread.state_entered_at || thread.updated_at
          %>
          <li style="display: flex; gap: 0.75rem; padding: 0.25rem 0; align-items: center;">
            <a href={~p"/threads/#{thread.id}"} style="font-family: monospace; font-size: 0.85em;">
              <%= GuildWeb.Format.anchor_label(thread) %>
            </a>
            <span class={"badge badge--#{thread.state}"}><%= thread.state %></span>
            <span class="muted" style="font-size: 0.8em;"><%= GuildWeb.Format.time_ago(ref) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <p class="page-subtitle">
    <%= length(@threads) %> threads, most recently updated first.
  </p>

  <%= if Enum.empty?(@threads) do %>
    <p class="empty-state">No threads yet. Run <code>mix guild.claim_seed</code> to create one.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Anchor</th>
          <th>State</th>
          <th>Owner</th>
          <th>Updated</th>
          <th>Created</th>
          <th>Stuck</th>
        </tr>
      </thead>
      <tbody>
        <%= for thread <- @threads do %>
          <%
            reference_time = thread.state_entered_at || thread.updated_at
            age_s = DateTime.diff(DateTime.utc_now(), reference_time)
            stuck? =
              (thread.state == "executing" and age_s > 7_200) or
              (thread.state == "pr_open" and age_s > 172_800)
          %>
          <tr>
            <td>
              <a href={~p"/threads/#{thread.id}"} class="anchor-link">
                <%= GuildWeb.Format.anchor_label(thread) %>
              </a>
            </td>
            <td><span class={"badge badge--#{thread.state}"}><%= thread.state %></span></td>
            <td class="muted"><%= thread.owner || "—" %></td>
            <td class="timestamp"><%= GuildWeb.Format.time(thread.updated_at) %></td>
            <td class="timestamp"><%= GuildWeb.Format.time(thread.inserted_at) %></td>
            <td>
              <%= if stuck? do %>
                <span class="badge badge--stuck">stuck</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
