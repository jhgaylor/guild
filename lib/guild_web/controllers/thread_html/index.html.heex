<Layouts.flash_group flash={@flash} />
<div class="container">
  <h1 class="page-title">Threads</h1>
  <p class="page-subtitle">
    <%= length(@threads) %> threads, most recently updated first.
  </p>

  <%= if Enum.empty?(@threads) do %>
    <p class="empty-state">No threads yet. Run <code>mix guild.claim_seed</code> to create one.</p>
  <% else %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Anchor</th>
          <th>State</th>
          <th>Owner</th>
          <th>Updated</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <%= for thread <- @threads do %>
          <tr>
            <td>
              <a href={~p"/threads/#{thread.id}"} class="anchor-link">
                <%= GuildWeb.Format.anchor_label(thread) %>
              </a>
            </td>
            <td><span class={"badge badge--#{thread.state}"}><%= thread.state %></span></td>
            <td class="muted"><%= thread.owner || "—" %></td>
            <td class="timestamp"><%= GuildWeb.Format.time(thread.updated_at) %></td>
            <td class="timestamp"><%= GuildWeb.Format.time(thread.inserted_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
